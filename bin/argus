#!/usr/bin/env bash
# Argus Unified CLI Entrypoint

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Auto-activate local virtual environment if present
if [ -f "${ROOT_DIR}/.venv/bin/activate" ]; then
    source "${ROOT_DIR}/.venv/bin/activate"
fi

if [ "$1" = "audit" ]; then
    shift
    exec python3 "${ROOT_DIR}/scripts/argus_cloud_audit.py" "$@"
elif [ "$1" = "serve-api" ]; then
    shift
    exec python3 -m uvicorn server.api:app --host 0.0.0.0 --port 8000 "$@"
elif [ "$1" = "serve-ui" ]; then
    shift
    exec python3 -m streamlit run "${ROOT_DIR}/server/app.py" --server.port 8501 "$@"
elif [ "$1" = "local-audit" ]; then
    shift
    exec "${ROOT_DIR}/esg_auditor" "$@"
elif [ "$1" = "test" ]; then
    shift
    exec "${ROOT_DIR}/tests/run_tests.sh" "$@"
else
    echo "ARGUS: Automated Satellite ESG & EUDR Compliance Suite"
    echo "Usage:"
    echo "  ./bin/argus audit <polygon.geojson> [options]         # Cloud STAC autonomous audit"
    echo "  ./bin/argus serve-api                                # Launch FastAPI REST API server (port 8000)"
    echo "  ./bin/argus serve-ui                                 # Launch Streamlit web dashboard (port 8501)"
    echo "  ./bin/argus local-audit <polygon> <base> <curr>      # Direct local C++ audit"
    echo "  ./bin/argus test                                     # Run full test suite"
    exit 1
fi
